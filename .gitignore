# SharePoint連携ツールのローカル設定・認証キャッシュ
po_database_organizer/config.json
po_database_organizer/token_cache.json
po_database_organizer/cache/

# Outlookオーガナイザー(振り返りタブ): 対象者ごとのゴール(KPI)定義。
# Nexperiaのゴールシート由来の機密情報(氏名・KPI・数値目標)を含むため、リポジトリには含めない。
outlook_total_organizer/json/review_person_goals.json

# OneNote Report Generator のローカル設定・認証キャッシュ・生成物
# bookmarks.jsonには実際のプロジェクト名・会議名・サイトIDが記録されるため、
# 社内情報保護の観点からリポジトリには含めない（config.example.jsonのみコミット）。
onenote_report_generator/config.json
onenote_report_generator/token_cache.bin
onenote_report_generator/bookmarks.json
onenote_report_generator/bookmarks.json.bak
onenote_report_generator/reports/*.html

# R19 Site Organizer のローカル設定・認証キャッシュ・実行時生成物
# sites_list_*.json / quick_links_*.json には実際のサイト名・サイトID・URLが
# 記録されるため、社内情報保護の観点からリポジトリには含めない（*.example.jsonのみコミット）。
r19_site_organizer/config.json
r19_site_organizer/token_cache.json
r19_site_organizer/download_prefs.json
r19_site_organizer/site_registry.json
r19_site_organizer/cache/
r19_site_organizer/sites_list_*.json
r19_site_organizer/quick_links_*.json
