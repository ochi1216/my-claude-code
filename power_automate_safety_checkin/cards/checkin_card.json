{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "text": "${TestPrefix}安否確認",
      "weight": "Bolder",
      "size": "Large"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Event ID", "value": "${EventID}" },
        { "title": "対象拠点", "value": "${SiteName}" },
        { "title": "対象地域震度", "value": "${Intensity}" },
        { "title": "発生日時", "value": "${OccurredAtJST}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "現在の状況を1つ選択してください。",
      "wrap": true
    },
    {
      "type": "Input.ChoiceSet",
      "id": "responseCode",
      "style": "expanded",
      "isRequired": true,
      "errorMessage": "状況を選択してください。",
      "choices": [
        { "title": "① 無事・出社可能", "value": "1" },
        { "title": "② 無事・出社不可", "value": "2" },
        { "title": "③ 被災・出社可能", "value": "3" },
        { "title": "④ 被災・出社不可", "value": "4" }
      ]
    },
    {
      "type": "Input.Text",
      "id": "comment",
      "label": "コメント（任意）",
      "isMultiline": true,
      "maxLength": 500
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "回答を送信",
      "data": {
        "eventId": "${EventID}",
        "employeeId": "${EmployeeID}",
        "schemaRevision": "poc_async_01"
      }
    }
  ]
}
